{
  "repositoryUrl": "https://github.com/DiogoGra/revanced-patches-legacy.git",
  "tagFormat": "${version}",
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer", {
        "releaseRules": [
          { "type": "build", "scope": "Needs bump", "release": "patch" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@MorpheApp/changelog", {
        "releaseJson": {
          "enabled": false
        }
      }
    ],
    "./scripts/release-plugin.cjs",
    [
      "@semantic-release/git",
      {
        "assets": [
          "README.md",
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "patches-list.json"
        ],
        "message": "chore: Release ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/release/patches.mpp",
            "name": "patches-<%= nextRelease.version %>.mpp"
          }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ],
    [
      "@cleyrop-org/semantic-release-backmerge",
      {
        "backmergeBranches": [{"from": "main", "to": "dev"}],
        "backmergeStrategy": "merge",
        "forcePush": false,
        "clearWorkspace": true
      }
    ]
  ]
}
